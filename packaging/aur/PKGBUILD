# Maintainer: Marvin Sarreal Villanueva <marvin@orin.work>
pkgname=qorx
pkgver=1.0.6
pkgrel=1
pkgdesc="Qorx programming language, compiler, and local runtime"
arch=('x86_64' 'aarch64')
url="https://github.com/bbrainfuckk/qorx"
license=('AGPL-3.0-only')
makedepends=('cargo')
# ring's native GCC-LTO objects cannot be linked by rust-lld.
options=('!lto')
source=("${pkgname}-${pkgver}.tar.gz::https://static.crates.io/crates/${pkgname}/${pkgname}-${pkgver}.crate")
sha256sums=('bd91cc52871dda6183375a14dfe96e87fc84deb1da3b605eb32ade90e11e9a0e')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release --locked
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  # v1.0.6 has five Windows/environment fixtures that are not portable to Linux.
  cargo test --locked -- \
    --skip config::tests::portable_marker_keeps_data_next_to_exe \
    --skip index::tests::generated_doc_assets_and_benchmarks_are_not_indexed \
    --skip adapters::tests::paper_qa_is_ready_when_local_corpus_and_backend_are_configured \
    --skip adapters::tests::paper_qa_reports_local_corpus_but_blocks_without_model_backend \
    --skip bootstrap_loads_cosmos_capsule_for_selected_folder_without_provider_calls
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 target/release/qorx "${pkgdir}/usr/bin/qorx"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
