[Unit]
Description=Qorx local context runtime
Documentation=https://github.com/bbrainfuckk/qorx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=qorx
Environment=QORX_HOME=/var/lib/qorx
Environment=QORX_BIND=127.0.0.1:47187
ExecStart=/usr/local/bin/qorx daemon
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/qorx
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
